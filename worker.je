export default {
  async fetch(request) {
    const url = new URL(request.url);
    const userId = url.searchParams.get('user_id') || 'guest';
    
    if (url.pathname === '/videos') {
      const html = `<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Videa</title><style>body{margin:0;background:#111;color:#fff;font-family:Arial;text-align:center}.header{padding:15px;background:#222}iframe{width:100%;height:calc(100vh - 60px);border:none;background:#fff}</style></head><body><div class="header">TomasEarn - Videa</div><iframe src="https://offerwall.ayet.io/offers?adSlot=30488&externalIdentifier=${userId}" allow="autoplay"></iframe></body></html>`;
      return new Response(html, {headers:{'Content-Type':'text/html'}});
    }
    
    return new Response('<h1>TomasEarn</h1><p><a href="/videos?user_id=test">VIDEA</a></p>', {headers:{'Content-Type':'text/html'}});
  }
}
